build/
debug/
*.o
*.dSYM/
.DS_Store
DerivedData/
*.xcworkspace/xcuserdata/

release/
plugins/

# Python bytecode from the ci/ tooling (M221 — committed by accident once)
__pycache__/
*.pyc

# lcov output from the bug-fix pipeline's coverage gate (ci/bugfix/verify.py).
# Written on every verified fix; a build report, not a source.
frontend/coverage/

# tools/desktop/package_linux.sh's output: a staged bundle, a tarball and an
# AppImage. Build products of a build product; the CI uploads them as
# artifacts and nobody should ever be tempted to commit one.
dist/

# Lane C — local OCCT install/build trees and benchmark output
backend/occt/install-host/
backend/occt/build-occt-host/
backend/occt/build*/
build-bench/
build-occt-shim/
build-backend/
bench-out/

# tools/desktop/build_cycles_linux.sh's work tree: a Blender checkout, its
# CMake build and the patched Cycles inside it. Several gigabytes of a build
# product, rebuilt by the script from a pinned commit.
backend/cycles/build-linux/

# M440 — debug dumps from the freeform segmenter, never a source file.
segments.txt
segments_split.txt

# M441 — the cloud mirror's Worker. `wrangler` writes a local state directory
# and npm would write node_modules if anything were ever added; the Worker
# itself has no dependencies and deploys as the two files it is.
cloud/.wrangler/
cloud/node_modules/

# Offline CAD runtime is reproduced from the committed SHA256 lock at build time.
frontend/assets/modelling/*.whl
frontend/assets/modelling/*.wasm
frontend/assets/modelling/pyodide.js
frontend/assets/modelling/pyodide.asm.js
frontend/assets/modelling/pyodide-lock.json
frontend/assets/modelling/python_stdlib.zip
frontend/assets/modelling/manifest.json
frontend/assets/modelling/THIRD_PARTY_NOTICES.txt
frontend/assets/modelling/Inter-Regular.ttf
frontend/assets/modelling/Inter-LICENSE.txt
frontend/assets/modelling/runner.py
